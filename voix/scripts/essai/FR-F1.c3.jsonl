{"line_id": "essai.c01.s01.A1", "voice": "FR-F1.c3", "accent": "fr", "text": "Mon réveil sonne.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.A2", "voice": "FR-F1.c3", "accent": "fr", "text": "Encore cinq minutes.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.A3", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai appuyé sur « répéter » (trois fois).", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.A5", "voice": "FR-F1.c3", "accent": "fr", "text": "C’est déjà le matin ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.B1", "voice": "FR-F1.c3", "accent": "fr", "text": "Réveille-toi ! / Allez, réveille-toi !", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.B2", "voice": "FR-F1.c3", "accent": "fr", "text": "Debout là-dedans !", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, with a smile", "register": "casual", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.B4", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu es réveillé ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.B5", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu vas être en retard.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.C2", "voice": "FR-F1.c3", "accent": "fr", "text": "Je dors encore à moitié.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.C3", "voice": "FR-F1.c3", "accent": "fr", "text": "Il est quelle heure ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.C4", "voice": "FR-F1.c3", "accent": "fr", "text": "Je n’arrive pas à garder les yeux ouverts.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.D1", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu as bien dormi ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.D2", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai dormi comme un loir.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.D3", "voice": "FR-F1.c3", "accent": "fr", "text": "Je n’ai pas fermé l’œil.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.D5", "voice": "FR-F1.c3", "accent": "fr", "text": "Je n’ai pas arrêté de me réveiller.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.E1", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai fait le rêve le plus bizarre.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.E3", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai rêvé que j’étais de retour à l’école.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.E4", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai vraiment cru que c’était vrai.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.E5", "voice": "FR-F1.c3", "accent": "fr", "text": "Je n’arrive pas à me rappeler de quoi j’ai rêvé.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.F2", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu m’as empêché de dormir toute la nuit.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.F3", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu m’as encore piqué la couette.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, with a smile", "register": "casual", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.F4", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu as entendu ce bruit cette nuit ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.G2", "voice": "FR-F1.c3", "accent": "fr", "text": "J’ai besoin de dormir davantage.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.G3", "voice": "FR-F1.c3", "accent": "fr", "text": "Je ne suis pas du matin.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.H1", "voice": "FR-F1.c3", "accent": "fr", "text": "Mon réveil n’a pas sonné.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.H2", "voice": "FR-F1.c3", "accent": "fr", "text": "Je ne me suis pas réveillé à temps.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.H3", "voice": "FR-F1.c3", "accent": "fr", "text": "Je suis en retard.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.H5", "voice": "FR-F1.c3", "accent": "fr", "text": "Je n’y arriverai jamais à temps.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.I1", "voice": "FR-F1.c3", "accent": "fr", "text": "Lève-toi !", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.I2", "voice": "FR-F1.c3", "accent": "fr", "text": "Je suis debout, je suis debout ! / Je me lève.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.I4", "voice": "FR-F1.c3", "accent": "fr", "text": "Hors du lit, tout de suite !", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.I5", "voice": "FR-F1.c3", "accent": "fr", "text": "Quelqu’un s’est levé du pied gauche.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, with a smile", "register": "casual", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.J2", "voice": "FR-F1.c3", "accent": "fr", "text": "Il y a trop de lumière !", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.J3", "voice": "FR-F1.c3", "accent": "fr", "text": "On gèle ici.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.J4", "voice": "FR-F1.c3", "accent": "fr", "text": "Tu peux allumer la lumière ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.K2", "voice": "FR-F1.c3", "accent": "fr", "text": "Bonjour, la marmotte.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, with a smile", "register": "casual", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.K3", "voice": "FR-F1.c3", "accent": "fr", "text": "Pardon, je t’ai réveillé ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.K4", "voice": "FR-F1.c3", "accent": "fr", "text": "Rendors-toi.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.L2", "voice": "FR-F1.c3", "accent": "fr", "text": "Attends, je regarde juste mon téléphone.", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
{"line_id": "essai.c01.s01.L3", "voice": "FR-F1.c3", "accent": "fr", "text": "Où sont mes lunettes ?", "context": "Explaining to a French friend what an English expression means.", "emotion": "natural, warm", "register": "everyday", "rhythm": "natural", "rythme": "sens", "genre": "sens"}
